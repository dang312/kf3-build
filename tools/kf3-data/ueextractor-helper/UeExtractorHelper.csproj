<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UeExtractorDir Condition="'$(UeExtractorDir)' == '' and '$(OS)' == 'Windows_NT'">C:\Temp\kf3-build-tools\ueextractor</UeExtractorDir>
    <UeExtractorDir Condition="'$(UeExtractorDir)' == ''">/mnt/c/Temp/kf3-build-tools/ueextractor</UeExtractorDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="UEExtractor">
      <HintPath>$(UeExtractorDir)\UEExtractor.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
